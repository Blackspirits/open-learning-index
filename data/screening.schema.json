{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Learning Index shallow-screening records",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "screen_id",
      "candidate_id",
      "screen_type",
      "decision",
      "screened_on",
      "canonical_url",
      "observed_free_access",
      "instruction_languages",
      "subtitle_languages",
      "credential",
      "completeness",
      "evidence",
      "rationale",
      "flags",
      "is_current"
    ],
    "properties": {
      "screen_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "screen_type": {"const": "shallow"},
      "decision": {"enum": ["advance", "hold", "reject"]},
      "screened_on": {"type": "string", "format": "date"},
      "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
      "observed_free_access": {
        "enum": ["F0_FULL_CREDENTIAL", "F1_FULL_ASSESSMENTS", "F2_CONTENT_ONLY", "F3_PARTIAL_OR_TRIAL", "UNVERIFIED"]
      },
      "instruction_languages": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 2}
      },
      "subtitle_languages": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 2}
      },
      "credential": {"type": "string", "minLength": 2},
      "completeness": {"enum": ["complete", "substantive", "partial", "unknown"]},
      "evidence": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "format": "uri", "pattern": "^https://"}
      },
      "rationale": {"type": "string", "minLength": 30},
      "flags": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      },
      "is_current": {"type": "boolean"},
      "supersedes_screen_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    }
  }
}
