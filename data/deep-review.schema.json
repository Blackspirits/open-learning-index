{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blackspirits/open-learning-index/blob/main/data/deep-review.schema.json",
  "title": "Open Learning Index deep-review ledger",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "review_id",
      "candidate_id",
      "reviewed_on",
      "canonical_url",
      "observed_free_access",
      "observed_status",
      "instruction_languages",
      "subtitle_languages",
      "credential",
      "academic_credits",
      "self_paced",
      "scope_notes",
      "prerequisites",
      "required_resources",
      "component_evidence",
      "quality_components",
      "quality_score",
      "recommendation_score",
      "recommendation_rationale",
      "comparators",
      "evidence",
      "flags",
      "is_current"
    ],
    "properties": {
      "review_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "candidate_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "reviewed_on": {
        "type": "string",
        "format": "date"
      },
      "canonical_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "observed_free_access": {
        "type": "string",
        "enum": [
          "F0_FULL_CREDENTIAL",
          "F1_FULL_ASSESSMENTS",
          "F2_CONTENT_ONLY",
          "F3_PARTIAL_OR_TRIAL",
          "UNVERIFIED"
        ]
      },
      "observed_status": {
        "type": "string",
        "enum": ["active", "active_archive", "retired", "unavailable"]
      },
      "instruction_languages": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 2},
        "uniqueItems": true
      },
      "subtitle_languages": {
        "type": "array",
        "items": {"type": "string", "minLength": 2},
        "uniqueItems": true
      },
      "credential": {
        "type": "string",
        "minLength": 2
      },
      "academic_credits": {
        "type": "string",
        "minLength": 2
      },
      "self_paced": {
        "type": "boolean"
      },
      "scope_notes": {
        "type": "string",
        "minLength": 30
      },
      "prerequisites": {
        "type": "string",
        "minLength": 2
      },
      "required_resources": {
        "type": "string",
        "minLength": 2
      },
      "component_evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pedagogy",
          "depth",
          "practice",
          "materials",
          "currency",
          "expertise",
          "accessibility"
        ],
        "properties": {
          "pedagogy": {"type": "string", "minLength": 20},
          "depth": {"type": "string", "minLength": 20},
          "practice": {"type": "string", "minLength": 20},
          "materials": {"type": "string", "minLength": 20},
          "currency": {"type": "string", "minLength": 20},
          "expertise": {"type": "string", "minLength": 20},
          "accessibility": {"type": "string", "minLength": 20}
        }
      },
      "quality_components": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pedagogy",
          "depth",
          "practice",
          "materials",
          "currency",
          "expertise",
          "accessibility"
        ],
        "properties": {
          "pedagogy": {"type": "number", "minimum": 0, "maximum": 10},
          "depth": {"type": "number", "minimum": 0, "maximum": 10},
          "practice": {"type": "number", "minimum": 0, "maximum": 10},
          "materials": {"type": "number", "minimum": 0, "maximum": 10},
          "currency": {"type": "number", "minimum": 0, "maximum": 10},
          "expertise": {"type": "number", "minimum": 0, "maximum": 10},
          "accessibility": {"type": "number", "minimum": 0, "maximum": 10}
        }
      },
      "quality_score": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "recommendation_score": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "recommendation_rationale": {
        "type": "string",
        "minLength": 30
      },
      "comparators": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "uniqueItems": true
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "uniqueItems": true
      },
      "flags": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "uniqueItems": true
      },
      "is_current": {
        "type": "boolean"
      },
      "supersedes_review_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  }
}
